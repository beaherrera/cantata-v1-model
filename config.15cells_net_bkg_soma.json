{
  "manifest": {
    "$BASE_DIR": ".",
    "$OUTPUT_DIR": "$BASE_DIR/output_15cells_net_bkg_only_soma",
    "$BKG_DIR": "$BASE_DIR/inputs/bkg",
    "$LGN_DIR": "$BASE_DIR/inputs/lgn",
    "$NETWORK_DIR": "$BASE_DIR/network_15cells_bkg_soma",
    "$COMPONENT_DIR": "$BASE_DIR/components"
  },

  "run": {
    "tstop": 3000.0,
    "dt": 0.01,
    "dL": 5.0,
    "spike_threshold": -15,
    "nsteps_block": 20000,
    "overwrite_output_dir": true
  },

  "target_simulator":"NEURON",

  "conditions": {
    "celsius": 34.0,
    "v_init": -80
  },

  "inputs": {
    "BKG_spikes": {
      "input_type": "spikes",
      "module": "sonata",
      "input_file": "$BKG_DIR/bkg_spikes_n1_fr1000_dt0.25_100trials.trial_0_modified.h5",
      "node_set": "bkg"
    }
  },

  "output":{
    "log_file": "log.txt",
    "output_dir": "$OUTPUT_DIR",
    "spikes_file": "spikes.h5",
    "spikes_file_csv": "spikes.csv"
  },

  "reports": {
    "membrane_potential": {
      "cells": {"population": "v1"},
      "variable_name": "v",
      "module": "membrane_report",
      "sections": "soma"
    }
  },

  "components": {
    "morphologies_dir": "$COMPONENT_DIR/morphologies/axon_stubs",
    "synaptic_models_dir": "$COMPONENT_DIR/synaptic_models",
    "mechanisms_dir":"$COMPONENT_DIR/mechanisms",
    "biophysical_neuron_models_dir": "$COMPONENT_DIR/biophysical_neuron_templates",
    "point_neuron_models_dir": "$COMPONENT_DIR/point_neuron_templates"
  },

  "networks": {
    "nodes": [
      {
        "nodes_file": "$NETWORK_DIR/v1_nodes.h5",
        "node_types_file": "$NETWORK_DIR/v1_node_types.csv"
      },
      {
        "nodes_file": "$NETWORK_DIR/bkg_nodes.h5",
        "node_types_file": "$NETWORK_DIR/bkg_node_types.csv"
      }
    ],
    "edges": [
      {
        "edges_file": "$NETWORK_DIR/bkg_v1_edges.h5",
        "edge_types_file": "$NETWORK_DIR/bkg_v1_edge_types.csv"
      }
    ]
  }

}
