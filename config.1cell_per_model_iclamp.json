{
  "manifest": {
    "$BASE_DIR": ".",
    "$OUTPUT_DIR": "$BASE_DIR/output_1cell_per_model_iclamp_dt0.01_dL5",
    "$BKG_DIR": "$BASE_DIR/inputs/bkg",
    "$LGN_DIR": "$BASE_DIR/inputs/lgn",
    "$NETWORK_DIR": "$BASE_DIR/network_1cell_per_model",
    "$COMPONENT_DIR": "$BASE_DIR/components"
  },

  "run": {
    "tstop": 9000.0,
    "dt": 0.01,
    "dL": 5.0,
    "spike_threshold": -15,
    "nsteps_block": 20000,
    "overwrite_output_dir": true
  },

  "target_simulator":"NEURON",

  "conditions": {
    "celsius": 34.0,
    "v_init": -80
  },

  "inputs": {
    "current_clamp_1": {
      "input_type": "current_clamp",
      "module": "IClamp",
      "node_set": {"population": "v1"},
      "amp": 0.15,
      "delay": 500.0,
      "duration": 2000.0,
      "section_name": "soma",
      "section_dist": 0.5
    },
    "current_clamp_2": {
      "input_type": "current_clamp",
      "module": "IClamp",
      "node_set": {"population": "v1"},
      "amp": 0.25,
      "delay": 3500.0,
      "duration": 2000.0,
      "section_name": "soma",
      "section_dist": 0.5
    },
    "current_clamp_3": {
      "input_type": "current_clamp",
      "module": "IClamp",
      "node_set": {"population": "v1"},
      "amp": 0.35,
      "delay": 6500.0,
      "duration": 2000.0,
      "section_name": "soma",
      "section_dist": 0.5
    }
  },

  "output":{
    "log_file": "log.txt",
    "output_dir": "$OUTPUT_DIR",
    "spikes_file": "spikes.h5",
    "spikes_file_csv": "spikes.csv"
  },

  "reports": {
    "membrane_potential": {
      "cells": {"population": "v1"},
      "variable_name": "v",
      "module": "membrane_report",
      "sections": "soma"
    }
  },

  "components": {
    "morphologies_dir": "$COMPONENT_DIR/morphologies/axon_stubs",
    "synaptic_models_dir": "$COMPONENT_DIR/synaptic_models",
    "mechanisms_dir":"$COMPONENT_DIR/mechanisms",
    "biophysical_neuron_models_dir": "$COMPONENT_DIR/biophysical_neuron_templates",
    "point_neuron_models_dir": "$COMPONENT_DIR/point_neuron_templates"
  },

  "networks": {
    "nodes": [
      {
        "nodes_file": "$NETWORK_DIR/v1_nodes.h5",
        "node_types_file": "$NETWORK_DIR/v1_node_types.csv"
      }
    ],
    "edges": []
  }

}
